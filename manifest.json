{
  "manifest_version": 3,
  "name": "디시 나만보이는메모장",
  "version": "0.5.1",
  "description": "메모장 켜라. 디시 댓글란에 남긴 메모는 이 Chrome에만 저장·표시되고 다른 사람에게는 보이지 않습니다.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-on-16.png",
    "32": "icons/icon-on-32.png",
    "48": "icons/icon-on-48.png",
    "128": "icons/icon-on-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gall.dcinside.com/board/view/*",
        "https://gall.dcinside.com/mgallery/board/view/*",
        "https://gall.dcinside.com/mini/board/view/*",
        "https://gall.dcinside.com/person/board/view/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "디시 나만보이는메모장 ON",
    "default_icon": {
      "16": "icons/icon-on-16.png",
      "24": "icons/icon-on-24.png",
      "32": "icons/icon-on-32.png"
    },
    "default_popup": "popup.html"
  }
}
